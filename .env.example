# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SQL_MODEL=sqlcoder          # sqlcoder / mistral / phi3
OLLAMA_REPORT_MODEL=mistral        # mistral / phi3
OLLAMA_TIMEOUT_SECONDS=120

# ── Metadata DB (Schema Registry) ────────────────────────────────────────────
REGISTRY_DB_URL=sqlite:///./data/registry.db

# ── Metrics / Source DB (read-only) ──────────────────────────────────────────
METRICS_DB_URL=sqlite:///./data/telecom_metrics.db
METRICS_DB_POOL_SIZE=5
METRICS_DB_MAX_OVERFLOW=10
QUERY_ROW_LIMIT=10000
QUERY_TIMEOUT_SECONDS=30

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20

# ── Audit Logging ─────────────────────────────────────────────────────────────
AUDIT_DB_URL=sqlite:///./data/audit.db

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
